@model List<Category>


<div>
    <a asp-controller="Category" asp-action="Create">Create Category</a>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Name</th>
                <th scope="col">Deleted Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @foreach (Category category in Model)
            {
                <tr>
                    <th scope="row">@category.Id</th>
                    <td>@category.Name</td>
                    <td>@category.IsDeleted</td>
                    <td>
                        <a class="btn btn-warning" asp-controller="Category" asp-action="Update" asp-route-id="@category.Id">Update</a>
                    </td>
                    <td>
                        @if (category.IsDeleted)
                        {
                            <form asp-controller="Category" asp-action="Restore" asp-route-id="@category.Id">
                                <button type="submit" class="btn btn-success">Restore</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>