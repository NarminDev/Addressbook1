@using Addressbook1.Areas.Admin.ViewModels.Category
@model UpdateCategoryVM

<form asp-controller="Category" asp-action="Update" method="post">
    <div class="form-group">
        <label for="name">Category Name</label>
        <input asp-for="@Model.Name" type="text" class="form-control" id="name" placeholder="Enter category">
        <span asp-validation-for="@Model.Name"></span>
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
</form>