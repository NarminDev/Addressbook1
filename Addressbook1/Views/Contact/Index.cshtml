@model IEnumerable<Addressbook1.Models.Contact>
@{
    ViewData["Title"] = "My Contacts";
    Layout = null; // Əlavə menyuların görünməməsi və tam tətbiq görünüşü üçün
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Addressbook</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
            /* Ümumi Səhifə Fonu (Yaşıl Tonlar) */
            body {
                background: linear-gradient(135deg, #e8ecef 0%, #a8d5c9 100%);
                font-family: 'Plus Jakarta Sans', sans-serif;
                min-height: 100vh;
                margin: 0;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            /* Yuxarı Sağ Küncdəki Log Out Düyməsi */
            .logout-container {
                position: absolute;
                top: 25px;
                right: 35px;
            }
            .logout-btn {
                background-color: #ff4d4d;
                color: white;
                border: none;
                padding: 10px 24px;
                border-radius: 6px;
                font-weight: 600;
                font-size: 0.95rem;
                cursor: pointer;
                box-shadow: 0 4px 15px rgba(255, 77, 77, 0.3);
                transition: all 0.3s ease;
            }
            .logout-btn:hover {
                background-color: #cc0000;
                transform: translateY(-2px);
            }

            /* Əsas Tətbiq Konteyneri (Telefon ölçüsündə) */
            .app-container {
                width: 400px;
                background: #ffffff;
                border-radius: 12px;
                box-shadow: 0 20px 40px rgba(0,0,0,0.15);
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            /* Üst Yaşıl Başlıq */
            .app-header {
                background-color: #0f9675;
                color: white;
                padding: 20px 24px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .app-header h3 {
                margin: 0;
                font-size: 1.4rem;
                font-weight: 700;
                letter-spacing: 0.5px;
            }

            /* Axtarış İkonu (Dairə) */
            .search-circle {
                width: 32px;
                height: 32px;
                background-color: white;
                border-radius: 50%;
                cursor: pointer;
                box-shadow: 0 2px 6px rgba(0,0,0,0.2);
                display: flex;
                justify-content: center;
                align-items: center;
                transition: transform 0.2s;
            }
            .search-circle:hover { transform: scale(1.1); }
            .search-circle::before { content: '🔍'; font-size: 14px; }

            /* Axtarış Paneli */
            .search-box {
                display: none;
                background-color: #0a7359;
                padding: 12px 24px;
            }
            .search-box input {
                width: 100%;
                padding: 12px 15px;
                border: none;
                border-radius: 6px;
                outline: none;
                box-sizing: border-box;
                font-family: inherit;
            }

            /* Kontaktların Siyahısı (Skroll Hissəsi - Stack Overflow qorunması) */
            .contact-list {
                max-height: 480px;
                overflow-y: auto;
                background-color: #f8f9fa;
            }

            /* Hər Bir Kontakt Sətri */
            .contact-item {
                padding: 16px 24px;
                border-bottom: 1px solid #eef2f5;
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-left: 5px solid #10b981;
                background-color: #ffffff;
                transition: background 0.2s;
            }
            .contact-item:nth-child(even) { border-left-color: #0f9675; }
            .contact-item:hover { background: #f1f5f9; }

            .contact-info h4 { margin: 0 0 5px 0; font-size: 1.1rem; color: #2d3748; font-weight: 600; }
            .contact-info p { margin: 0; font-size: 0.9rem; color: #718096; }

            /* Silmə Düyməsi */
            .btn-delete {
                background: none;
                border: none;
                color: #ff4d4d;
                cursor: pointer;
                font-size: 1.3rem;
                padding: 8px;
                transition: color 0.2s;
            }
            .btn-delete:hover { color: #cc0000; }

            /* Əlavə Etmə Düyməsi (+ Add new contact) */
            .add-contact-btn {
                text-align: center;
                padding: 18px;
                background: #ffffff;
                color: #0f9675;
                font-weight: 700;
                cursor: pointer;
                border-top: 1px solid #eef2f5;
                transition: background 0.2s;
            }
            .add-contact-btn:hover { background: #f0fdf4; }

            /* --- PƏNCƏRƏLƏR (MODALLAR) --- */
            .modal-overlay {
                display: none;
                position: fixed; top: 0; left: 0; width: 100%; height: 100%;
                background: rgba(0,0,0,0.5);
                backdrop-filter: blur(3px);
                justify-content: center; align-items: center;
                z-index: 1000;
            }
            .modal-content {
                background: white; padding: 30px; border-radius: 12px;
                width: 320px; box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            }
            .modal-content h4 { margin-top: 0; margin-bottom: 20px; color: #0f9675; font-size: 1.3rem; }
            .form-control {
                width: 100%; padding: 12px 15px; margin-bottom: 15px;
                border: 1px solid #e2e8f0; border-radius: 6px; box-sizing: border-box;
                outline: none; font-family: inherit;
            }
            .form-control:focus { border-color: #0f9675; box-shadow: 0 0 0 3px rgba(15, 150, 117, 0.1); }

            .modal-actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px; }
            .btn { padding: 10px 18px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; font-family: inherit; }
            .btn-primary { background: #0f9675; color: white; }
            .btn-danger { background: #ff4d4d; color: white; }
            .btn-secondary { background: #e2e8f0; color: #4a5568; }

            /* Skroll bar dizaynı */
            ::-webkit-scrollbar { width: 6px; }
            ::-webkit-scrollbar-track { background: #f1f1f1; }
            ::-webkit-scrollbar-thumb { background: #cbd5e0; border-radius: 3px; }
            ::-webkit-scrollbar-thumb:hover { background: #a0aec0; }
    </style>
</head>
<body>

    <!-- Yuxarı Sağ Küncdəki Log Out Düyməsi -->
    <div class="logout-container">
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="logout-btn">Log Out</button>
        </form>
    </div>

    <div class="app-container">
        <!-- Başlıq Hissəsi -->
        <div class="app-header">
            <h3>Kasper contacts</h3>
            <!-- Axtarış İkonu -->
            <div class="search-circle" onclick="toggleSearch()" title="Axtarış Et"></div>
        </div>

        <!-- Axtarış Qutusu (Basıldıqda açılır) -->
        <div class="search-box" id="searchBox">
            <form asp-action="Index" method="get">
                <input type="text" name="searchQuery" value="@ViewData["SearchQuery"]" placeholder="İsim və ya nömrə axtar..." autocomplete="off" />
            </form>
        </div>

        <!-- Kontakt Siyahısı (Skroll edilə bilən sahə) -->
        <div class="contact-list">
            @if (Model != null && Model.Any())
            {
                foreach (var contact in Model)
                {
                    <div class="contact-item">
                        <div class="contact-info">
                            <h4>@contact.Name @contact.Surname</h4>
                            <p>@contact.Phone</p>
                        </div>
                        <!-- Zibil Qutusu İkonu (Hard Delete) -->
                        <button type="button" class="btn-delete" onclick="openDeleteModal(@contact.Id, '@contact.Name @contact.Surname')" title="Sil">🗑️</button>
                    </div>
                }
            }
            else
            {
                <div style="padding: 30px; text-align: center; color: #a0aec0;">
                    Hələ heç bir kontakt əlavə edilməyib.
                </div>
            }
        </div>

        <!-- + Əlavə Et düyməsi siyahının ən altında, həmişə görünür -->
        <div class="add-contact-btn" onclick="openAddModal()">
            + Add new contact
        </div>
    </div>

    <!-- 1. YENİ KONTAKT ÜÇÜN MODAL PƏNCƏRƏ -->
    <div class="modal-overlay" id="addModal">
        <div class="modal-content">
            <h4>Yeni Kontakt</h4>
            <!-- Controller-dəki Create action-una göndərir -->
            <form asp-action="Create" asp-controller="Contacts" method="post">
                <input type="text" name="Name" class="form-control" placeholder="Ad" required />
                <input type="text" name="Surname" class="form-control" placeholder="Soyad" required />
                <input type="text" name="Phone" class="form-control" placeholder="Telefon" required />
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModals()">Ləğv et</button>
                    <button type="submit" class="btn btn-primary">Əlavə et</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 2. SİLMƏ ÜÇÜN XƏBƏRDARLIQ MODALI (Hard Delete) -->
    <div class="modal-overlay" id="deleteModal">
        <div class="modal-content">
            <h4>Silinmə Təsdiqi</h4>
            <p>Əminsiniz ki, <b id="deleteContactName"></b> adlı kontaktı silmək istəyirsiniz?</p>
            <form id="deleteForm" asp-action="Delete" asp-controller="Contacts" method="post">
                <!-- Silinəcək kontaktın ID-si bura yazılır -->
                <input type="hidden" name="id" id="deleteContactId" />
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModals()">Xeyr</button>
                    <button type="submit" class="btn btn-danger">Bəli, sil</button>
                </div>
            </form>
        </div>
    </div>

    <script>
            // Axtarış panelini aç/bağla
            function toggleSearch() {
                var box = document.getElementById('searchBox');
                if (box.style.display === 'block') {
                    box.style.display = 'none';
                } else {
                    box.style.display = 'block';
                    box.querySelector('input').focus();
                }
            }

            // Əlavə etmə pəncərəsini aç
            function openAddModal() {
                document.getElementById('addModal').style.display = 'flex';
            }

            // Silmə pəncərəsini aç və seçilən kontaktın məlumatlarını içinə yaz
            function openDeleteModal(id, fullName) {
                document.getElementById('deleteContactId').value = id;
                document.getElementById('deleteContactName').innerText = fullName;
                document.getElementById('deleteModal').style.display = 'flex';
            }

            // Bütün pəncərələri bağla
            function closeModals() {
                document.getElementById('addModal').style.display = 'none';
                document.getElementById('deleteModal').style.display = 'none';
            }

            // Əgər istifadəçi modalın çölünə toxunarsa pəncərə bağlansın
            window.onclick = function (event) {
                if (event.target.classList.contains('modal-overlay')) {
                    closeModals();
                }
            }
    </script>
</body>
</html>