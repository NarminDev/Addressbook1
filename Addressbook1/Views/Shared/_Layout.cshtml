<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Address Book</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
            :root {
                --olive-dark: #233118; /* Tünd zeytun */
                --olive-primary: #4a6132; /* Əsas zeytun */
                --olive-light: #8ba272; /* Yumşaq zeytun */
                --text-dark: #1a2412; /* Tünd mətn */
                --text-muted: #3a4c28; /* İkinci dərəcəli mətn */
                /* Kart Rəngləri */
                --card-bg: #dce7d3; /* Kartın ilkin açıq zeytun fonu */
                --card-hover-bg: #b2c8a2; /* Üstünə gəldikdə 2 ton tündləşən fon */
                --card-border: #9cb288; /* Kart çərçivəsi */
                --card-hover-border: #4a6132; /* Hover zamanı tünd çərçivə */
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background-color: #c0d1ac;
                background-image: radial-gradient(at 10% 10%, rgba(235, 242, 226, 0.85) 0px, transparent 50%), radial-gradient(at 90% 15%, rgba(74, 97, 50, 0.25) 0px, transparent 50%), radial-gradient(at 50% 85%, rgba(245, 248, 241, 0.9) 0px, transparent 50%), radial-gradient(at 80% 80%, rgba(139, 162, 114, 0.4) 0px, transparent 50%);
                background-attachment: fixed;
                color: var(--text-dark);
                font-family: 'Plus Jakarta Sans', sans-serif;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* Frosted Glass Header */
            header {
                background: rgba(245, 248, 241, 0.65);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border-bottom: 1px solid rgba(255, 255, 255, 0.6);
                padding: 16px 50px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                position: sticky;
                top: 0;
                z-index: 100;
                box-shadow: 0 4px 20px rgba(35, 49, 24, 0.05);
            }

            .brand-logo {
                display: flex;
                align-items: center;
                gap: 12px;
                font-family: 'Playfair Display', serif;
                font-size: 1.6em;
                font-weight: 700;
                color: var(--olive-dark);
                text-decoration: none;
                letter-spacing: 0.5px;
            }

                .brand-logo span {
                    color: var(--olive-primary);
                    font-style: italic;
                }

            .auth-buttons {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .btn-auth {
                padding: 10px 24px;
                font-size: 0.9em;
                font-weight: 600;
                border-radius: 30px;
                text-decoration: none;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .btn-login {
                background: rgba(255, 255, 255, 0.5);
                color: var(--olive-dark);
                border: 1.5px solid var(--olive-primary);
                backdrop-filter: blur(4px);
            }

                .btn-login:hover {
                    background: var(--olive-primary);
                    color: #ffffff;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 15px rgba(74, 97, 50, 0.2);
                }

            .btn-register {
                background: var(--olive-dark);
                color: #ffffff;
                border: 1.5px solid var(--olive-dark);
                box-shadow: 0 4px 14px rgba(35, 49, 24, 0.25);
            }

                .btn-register:hover {
                    background: var(--olive-primary);
                    border-color: var(--olive-primary);
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(74, 97, 50, 0.35);
                }

            .main-content {
                flex: 1;
                padding: 50px 20px;
                max-width: 1140px;
                width: 100%;
                margin: 0 auto;
            }

            footer {
                background: rgba(245, 248, 241, 0.5);
                backdrop-filter: blur(10px);
                border-top: 1px solid rgba(255, 255, 255, 0.5);
                text-align: center;
                padding: 22px;
                font-size: 0.88em;
                color: var(--text-muted);
                font-weight: 600;
            }
    </style>
</head>
<body>

    <header>
        <a href="/" class="brand-logo">
            🌿 <span>ADDRESS BOOK</span>
        </a>

        <div class="auth-buttons">
            <a href="/Account/Login" class="btn-auth btn-login">Login</a>
            <a href="/Account/Register" class="btn-auth btn-register">Register</a>
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer>
        <p>© 2026 Address Book System • Aesthetic Olive Edition</p>
    </footer>

</body>
</html>